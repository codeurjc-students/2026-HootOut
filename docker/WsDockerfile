FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS base
RUN mkdir -p /var/logs && chown -R $APP_UID /var/logs
USER $APP_UID
WORKDIR /app 
EXPOSE ${ASPNETCORE_HTTPS_PORTS}

# This stage is used to build the service project
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
ARG BUILD_CONFIGURATION=Release
WORKDIR /src
COPY ["HootOutWebsockets/HootOutWebsockets.csproj", "HootOutWebsockets/"]
RUN dotnet restore "./HootOutWebsockets/HootOutWebsockets.csproj"
COPY . .
WORKDIR "/src/HootOutWebsockets"
RUN dotnet build "./HootOutWebsockets.csproj" -c $BUILD_CONFIGURATION -o /app/build

# This stage is used to publish the service project to be copied to the final stage
FROM build AS publish
ARG BUILD_CONFIGURATION=Release
RUN dotnet publish "./HootOutWebsockets.csproj" -c $BUILD_CONFIGURATION -o /app/publish /p:UseAppHost=false

FROM base AS final
WORKDIR /app
COPY --from=publish /app/publish .
ENTRYPOINT ["dotnet", "HootOut.HootOutWebsockets.dll"]