{
  "AllowedHosts": "*",
  "NLog": {
    "throwConfigExceptions": true,
    "time": {
      "type": "AccurateUTC"
    },
    "targets": {
      "async": true,
      "logfile": {
        "type": "File",
        "fileName": "${environment:LOGS_FOLDER}/hootout/hootoutapi/${shortdate}.log"
      },
      "logconsole": {
        "type": "ColoredConsole"
      }
    },
    "rules": [
      {
        "logger": "*",
        "minLevel": "Info",
        "writeTo": "logconsole"
      },
      {
        "logger": "*",
        "minLevel": "Info",
        "writeTo": "logfile"
      }
    ]
  }
}
